---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { photo } from '../lib/images';

interface Props {
  src: string | ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  [key: `data-${string}`]: string;
}

const { src, alt, sizes = '100vw', widths = [480, 800, 1200], class: cls, loading = 'lazy', fetchpriority, ...rest } = Astro.props;
const image = typeof src === 'string' ? photo(src) : src;

// Never upscale: drop widths larger than the original and cap with the original width
const fit = widths.filter((w) => w < image.width);
const finalWidths = fit.length === widths.length ? fit : [...fit, image.width];
const largest = Math.max(...finalWidths);

// Per-format quality — each encoder has its own scale; these look identical to the originals at a fraction of the size
const [avif, webp, fallback] = await Promise.all([
  getImage({ src: image, widths: finalWidths, format: 'avif', quality: 50 }),
  getImage({ src: image, widths: finalWidths, format: 'webp', quality: 70 }),
  getImage({ src: image, width: largest, format: 'jpg', quality: 75 }),
]);
---
<picture>
  <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
  <source type="image/webp" srcset={webp.srcSet.attribute} sizes={sizes} />
  <img
    src={fallback.src}
    alt={alt}
    width={image.width}
    height={image.height}
    class={cls}
    loading={loading}
    decoding={loading === 'eager' ? 'sync' : 'async'}
    fetchpriority={fetchpriority}
    {...rest}
  />
</picture>
