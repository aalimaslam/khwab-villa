---
import { getCollection } from 'astro:content';
import PostCard from './PostCard.astro';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---
<section class="section journal">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="kicker reveal">Our Blogs</p>
        <h2 class="reveal">Stories &amp; <em>Travel Guides</em></h2>
      </div>
      <a href="/blog/" class="btn btn--outline reveal">All Blogs <svg><use href="#i-arrow" /></svg></a>
    </div>
    <div class="post-grid">{posts.map((p) => <PostCard post={p} />)}</div>
  </div>
</section>
