---
import Photo from './Photo.astro';
interface Props { kicker: string; title: string; image: string; text?: string; crumbs?: { href: string; label: string }[] }
const { kicker, title, image, text, crumbs = [] } = Astro.props;
---
<section class="page-hero">
  <Photo src={image} alt="" sizes="100vw" loading="eager" fetchpriority="high" />
  <div class="page-hero__inner container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      {crumbs.map((c) => <><span>/</span><a href={c.href}>{c.label}</a></>)}
    </nav>
    <p class="kicker kicker--light rise">{kicker}</p>
    <h1 class="rise" style="--d:.08s" set:html={title} />
    {text && <p class="page-hero__text rise" style="--d:.16s">{text}</p>}
  </div>
</section>
