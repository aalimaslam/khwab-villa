---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Reserve from '../components/Reserve.astro';
import { SITE } from '../site';
---
<Base title="Contact & Reservations" description={`Reserve your stay at Khwab Villa, Preng, Kangan. Call ${SITE.phones.join(' / ')} or email ${SITE.email}.`}>
  <PageHero kicker="Contact" title="Plan Your <em>Stay</em>" image="bonfire-villa" crumbs={[{ href: '/contact/', label: 'Contact' }]} />
  <div class="spacer"></div>
  <Reserve />
</Base>
