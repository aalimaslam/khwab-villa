---
import Base from '../layouts/Base.astro';
import { img } from '../site';
---
<Base title="Page Not Found">
  <section class="page-hero page-hero--tall">
    <img src={img('drone-night')} alt="" />
    <div class="page-hero__inner container">
      <p class="kicker kicker--light">404</p>
      <h1>Lost in the <em>Mountains</em></h1>
      <p class="page-hero__text">The page you’re looking for has wandered off. Let’s get you back to the villa.</p>
      <a href="/" class="btn btn--cream" style="margin-top:28px">Back to Home <svg><use href="#i-arrow" /></svg></a>
    </div>
  </section>
</Base>
