---
import Base from '../layouts/Base.astro';
import About from '../components/About.astro';
import Rooms from '../components/Rooms.astro';
import Experiences from '../components/Experiences.astro';
import Band from '../components/Band.astro';
import Facilities from '../components/Facilities.astro';
import Gallery from '../components/Gallery.astro';
import Attractions from '../components/Attractions.astro';
import Reviews from '../components/Reviews.astro';
import BlogTeaser from '../components/BlogTeaser.astro';
import Reserve from '../components/Reserve.astro';
import { SITE } from '../site';
import Photo from '../components/Photo.astro';
---
<Base floatingHeader>
  <section class="hero" id="top">
    <div class="hero__panel">
      <div class="hero__nav">
        <a href="/" class="brand"><span>Khwab Villa</span></a>
        <nav class="navlinks" aria-label="Hero">
          <a href="/" class="is-active">Home</a>
          <a href="/rooms/">Rooms</a>
          <a href="/gallery/">Gallery</a>
          <a href="/blog/">Blogs</a>
          <a href="/about/">About</a>
        </nav>
      </div>

      <div class="hero__copy">
        <div class="hero__headline">
          <h1 class="rise">Your <em>Dream</em> Stay in Kashmir</h1>
          <div class="hero__faces rise" style="--d:.15s" aria-hidden="true">
            <Photo src="bedroom-6" alt="" class="f1" sizes="60px" widths={[120]} />
            <Photo src="bonfire-villa" alt="" class="f2" sizes="52px" widths={[120]} />
            <Photo src="breakfast-table" alt="" class="f3" sizes="44px" widths={[120]} />
            <span class="f4">5<small>rooms</small></span>
          </div>
        </div>
        <p class="eyebrow rise" style="--d:.1s">A dream retreat amidst the mountains</p>
        <div class="hero__intro rise" style="--d:.2s">
          <p>Nestled in Preng, Kangan, Khwab Villa blends Kashmiri heritage with modern comfort — five elegant bedrooms, orchard gardens and the Sindh River just a stroll away.</p>
          <a href="#about" class="btn btn--olive">Explore More <svg><use href="#i-arrow" /></svg></a>
        </div>
        <div class="stats rise" style="--d:.3s">
          <div><strong data-count="5">05</strong><span>Luxury Bedrooms</span></div>
          <div><strong data-count="4">04</strong><span>Orchard Gardens</span></div>
          <div><strong data-count="16" data-suffix="+">16+</strong><span>Amenities</span></div>
        </div>
      </div>

      <a href="/rooms/" class="hero__room">
        <Photo src="bedroom-5" alt="Super Deluxe bedroom with carved wooden bed and mountain-facing windows" sizes="(max-width: 760px) calc(100vw - 36px), (max-width: 1100px) calc(100vw - 52px), 42vw" loading="eager" fetchpriority="high" />
        <span class="chip"><svg><use href="#i-pin" /></svg>Preng, Kangan</span>
        <span class="icon-btn icon-btn--light heart" aria-hidden="true"><svg><use href="#i-heart" /></svg></span>
        <div class="hero__room-info">
          <strong>Super Deluxe Room</strong>
          <span><b>{SITE.price}</b> / room · night</span>
        </div>
      </a>
    </div>

    <div class="hero__visual">
      <div class="hero__slides" data-hero-slides>
        <Photo src="night-view" alt="Khwab Villa glowing at dusk against the mountains" class="is-active" sizes="(max-width: 1100px) 100vw, 54vw" loading="eager" fetchpriority="high" />
        <Photo src="front-view-1" alt="Khwab Villa front lawn in autumn" sizes="(max-width: 1100px) 100vw, 54vw" fetchpriority="low" />
        <Photo src="drone-night" alt="Aerial view of Khwab Villa at night in the valley" sizes="(max-width: 1100px) 100vw, 54vw" fetchpriority="low" />
      </div>
      <div class="hero__shade"></div>

      <div class="hero__top">
        <a href={`tel:${SITE.phones[0].replace(/-/g, '')}`} class="pill">Contact Us <svg><use href="#i-phone" /></svg></a>
      </div>

      <a href="/attractions/" class="float-card">
        <div>
          <strong>Ganderbal, Kashmir</strong>
          <span>Mountain Villa · Sindh River</span>
          <span class="round-arrow"><svg><use href="#i-arrow" /></svg></span>
        </div>
        <Photo src="drone-valley" alt="Aerial view of the valley around Khwab Villa" sizes="110px" widths={[240]} />
      </a>

      <div class="hero__glass">
        <p>Wake up to mountain views, unwind by a bonfire under the stars, and savour breakfast among walnut, cherry and apricot trees.</p>
        <div class="dots" data-hero-dots><button class="is-active" aria-label="Slide 1"></button><button aria-label="Slide 2"></button><button aria-label="Slide 3"></button></div>
      </div>

      <form class="searchbar" data-quickbook>
        <label class="field">
          <svg><use href="#i-cal" /></svg>
          <input type="date" name="checkin" aria-label="Check in" required />
        </label>
        <label class="field">
          <svg><use href="#i-users" /></svg>
          <select name="adults" aria-label="Guests">
            {[2, 1, 3, 4, 5, 6, 8, 10].map((n) => <option value={n}>{n} {n === 1 ? 'Adult' : 'Adults'}</option>)}
          </select>
        </label>
        <button class="btn btn--ghost" type="submit">Check Now <svg><use href="#i-arrow" /></svg></button>
      </form>
    </div>
  </section>

  <About />
  <Rooms />
  <Experiences />
  <Band />
  <Facilities />
  <Gallery limit={10} />
  <Attractions />
  <Reviews />
  <BlogTeaser />
  <Reserve />
</Base>
