---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Attractions from '../components/Attractions.astro';
import BlogTeaser from '../components/BlogTeaser.astro';
import { ATTRACTIONS } from '../site';
import { photo } from '../lib/images';

const list = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Attractions near Khwab Villa',
  itemListElement: ATTRACTIONS.map((a, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'TouristAttraction', name: a.name, description: a.text } })),
};
---
<Base title="Nearby Attractions" description="Explore around Khwab Villa: the Sindh River, Wayil, Kheer Bhawani Temple, Naranag Temple, Manasbal Lake and Sonmarg — with distances from the villa." image={photo('drone-valley')} imageAlt="Aerial view of the Sindh valley around Kangan" jsonLd={[list]}>
  <PageHero kicker="Explore" title="Around <em>Ganderbal</em>" image="drone-valley" text="Rivers, lakes, ancient temples and the Meadow of Gold — all within easy reach." crumbs={[{ href: '/attractions/', label: 'Attractions' }]} />
  <Attractions />
  <BlogTeaser />
</Base>
